{"nodes": [{"id": "web_index_viewport", "label": "Meta viewport con viewport-fit=cover y zoom libre", "file_type": "rationale", "source_file": "web/index.html", "source_location": "L6-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "viewport-fit=cover es lo que habilita env(safe-area-inset-*); sin esto la barra de navegaci\u00f3n queda debajo de la barra de gestos de iOS y no se puede tocar. maximum-scale se deja libre a prop\u00f3sito: bloquear el zoom rompe la accesibilidad. El zoom al enfocar un input se evita con font-size de 16px, no capando el gesto."}, {"id": "web_index_theme_color", "label": "theme-color por esquema (#f7f8f9 claro / #14181c oscuro)", "file_type": "concept", "source_file": "web/index.html", "source_location": "L19-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un theme-color por prefers-color-scheme: la barra del navegador acompa\u00f1a al papel de la app en claro y en oscuro."}, {"id": "web_index_meta_pwa", "label": "Metas de instalaci\u00f3n (apple-mobile-web-app-*, mobile-web-app-capable, apple-touch-icon)", "file_type": "concept", "source_file": "web/index.html", "source_location": "L32-L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "web_index_raiz", "label": "div#raiz (punto de montaje de React)", "file_type": "code", "source_file": "web/index.html", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "web_index_main_tsx", "label": "Entrada del m\u00f3dulo: /src/main.tsx", "file_type": "code", "source_file": "web/index.html", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "web_index_viewport", "target": "design_alcance_del_pulgar", "relation": "references", "confidence": "INFERRED", "confidence_score":