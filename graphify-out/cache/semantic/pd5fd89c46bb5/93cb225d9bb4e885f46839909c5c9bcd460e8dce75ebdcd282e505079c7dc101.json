{"nodes": [{"id": "docs_capturas_captura_pantalla_nuevo_gasto", "label": "Pantalla Nuevo gasto", "file_type": "image", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile-first single-column capture form: all inputs are chips, so a typical expense (amount + category + account) can be saved with very few taps. Screenshot of the Saldus PWA expense form."}, {"id": "docs_capturas_captura_selector_tipo_gasto_ingreso", "label": "Selector de tipo Gasto/Ingreso", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Segmented control at top with Gasto preselected; the sign of the movement is derived from the type, not from the amount."}, {"id": "docs_capturas_captura_campo_monto", "label": "Campo de monto", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large '$ 0.00' display with two-decimal USD format; dominant visual element because the amount is the first thing entered."}, {"id": "docs_capturas_captura_montos_frecuentes", "label": "Montos frecuentes sugeridos", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chips 0.70, 3.75, 4.14, 9.99 below the amount field; one-tap amounts derived from usage history to shorten capture (bus fare, lunch, etc.)."}, {"id": "docs_capturas_captura_selector_fecha_rapida", "label": "Selector de fecha rapida Hoy/Ayer/Otro dia", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hoy preselected as default; Ayer as a first-class option because registering yesterday's expense is the normal case; Otro dia opens a date picker only when needed."}, {"id": "docs_capturas_captura_chips_categoria", "label": "Chips de categoria", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bus, Almuerzo, Cafe y snacks, Salidas, Restaurantes, Supermercado plus a 'Todas' overflow chip. Order is by recent usage frequency, not alphabetical, so the most likely category is the first chip; 'Todas' reveals the full list."}, {"id": "docs_capturas_captura_chips_cuenta", "label": "Chips de cuenta", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Efectivo, Visa, Banco Pichincha, Ahorros. Efectivo preselected as the last-used account; accounts are Ecuador-specific (Banco Pichincha)."}, {"id": "docs_capturas_captura_campo_descripcion", "label": "Campo de descripcion opcional", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed last with placeholder 'Opcional' so it never blocks saving; free text is the only non-chip input."}, {"id": "docs_capturas_captura_boton_guardar_gasto", "label": "Boton Guardar gasto", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-width primary button pinned above the bottom nav (sticky footer) so it is always reachable with the thumb; label changes with the selected type."}, {"id": "docs_capturas_captura_barra_navegacion_inferior", "label": "Barra de navegacion inferior", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four tabs: Movimientos, Cuentas, Resumen, Ajustes. Reveals the app's four top-level sections; Resumen is the dashboard section."}, {"id": "docs_capturas_captura_captura_en_dos_toques", "label": "Captura en dos toques", "file_type": "concept", "source_file": "docs/capturas/captura.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design goal visible in the screen: sensible defaults (Hoy, first category, last account) plus suggested amounts mean a common expense needs only amount + save."}], "edges": [{"source": "docs_capturas_captura_pantalla_nuevo_gasto", "target": "docs_capturas_captura_selector_tipo_gasto_ingreso", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/capturas/captura.png", "source_location": null, "weight": 1.0}, {"source": "docs_capturas_captura_pantalla_nuevo_gasto", "target": "docs_capturas_captura_campo_monto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/capturas/captura.png", "source_location": null, "weight": 1.0}, {"source": "docs_capturas_captura_pantalla_nuevo_gasto", "target": "docs_capturas_captura_montos_frecuentes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/capturas/captura.png", "source_location": null, "weight": 1.0}, {"source": "docs_capturas_captura_pantalla_nuevo_gasto", "target": "docs_capturas_captura_selector_fecha_rapida", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/capturas/captura.png", "source_location": null, "weight": 1.0}, {"source": "docs_capturas_captura_pantalla_nuevo_gasto", "target": "docs_capturas_captura_chips_categoria", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour