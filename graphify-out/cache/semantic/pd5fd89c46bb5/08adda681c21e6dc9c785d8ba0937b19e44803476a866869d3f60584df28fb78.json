{"nodes": [{"id": "docs_capturas_movimientos_pantalla_movimientos", "label": "Pantalla Movimientos", "file_type": "image", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile-first single-column screenshot of the main transactions list of Saldus. It is the default landing tab of the PWA: month navigator, monthly spend total, search, filters, day-grouped list, primary Registrar button and bottom tab bar."}, {"id": "docs_capturas_movimientos_navegador_de_mes", "label": "Navegador de mes", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prev/next chevrons around 'Septiembre de 2026'. The list and the monthly total are scoped to the selected month; the accounting month is the primary time unit of the app."}, {"id": "docs_capturas_movimientos_total_gastado_del_mes", "label": "Total gastado del mes", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large 'Gastado $340.67' metric at the top, computed locally from IndexedDB for the selected month. Displayed with two decimals in USD, consistent with cents-as-integers handling."}, {"id": "docs_capturas_movimientos_buscador_de_historial", "label": "Buscador en todo el historial", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search field with placeholder 'Buscar en todo el historial'. Unlike the month-scoped list, search spans the whole local replica, which is feasible because the full dataset lives in IndexedDB."}, {"id": "docs_capturas_movimientos_boton_filtros", "label": "Bot\u00f3n Filtros", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secondary button next to the search box to narrow the list (likely by account, category or type)."}, {"id": "docs_capturas_movimientos_lista_agrupada_por_dia", "label": "Lista agrupada por d\u00eda", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transactions grouped under relative-day headers ('Hoy', 'Ayer') with a per-day subtotal on the right (-326.65, -9.06). Grouping is by the accounting date 'fecha', not by creation timestamp."}, {"id": "docs_capturas_movimientos_fila_de_movimiento", "label": "Fila de movimiento", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-line row: description (Arriendo, Almuerzo, Pasajes, Taxi) over category (Vivienda, Comida, Bus, Transporte) on the left; signed amount over account (Banco Pichincha, Efectivo) on the right. Sign comes from tipo (GASTO shows as negative), amounts always with two decimals."}, {"id": "docs_capturas_movimientos_boton_registrar", "label": "Bot\u00f3n Registrar", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-width dark-blue primary CTA pinned above the tab bar. It is the entry point to the capture form and only appears on the Movimientos tab (see commit 'dejar la accion de registrar solo en Movimientos'). Sticky placement serves the two-tap capture goal."}, {"id": "docs_capturas_movimientos_barra_de_navegacion_inferior", "label": "Barra de navegaci\u00f3n inferior", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four tabs with icons: Movimientos (active), Cuentas, Resumen, Ajustes. Defines the top-level information architecture of the PWA."}, {"id": "docs_capturas_movimientos_tab_cuentas", "label": "Tab Cuentas", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_capturas_movimientos_tab_resumen", "label": "Tab Resumen", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bar-chart icon; the dashboards tab (Fase 3), computed locally."}, {"id": "docs_capturas_movimientos_tab_ajustes", "label": "Tab Ajustes", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_capturas_movimientos_cuenta_efectivo", "label": "Cuenta Efectivo", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most frequent account in the rows shown; small daily expenses (almuerzo, pasajes, caf\u00e9, taxi) are paid in cash, typical for Ecuador."}, {"id": "docs_capturas_movimientos_cuenta_banco_pichincha", "label": "Cuenta Banco Pichincha", "file_type": "concept", "source_file": "docs/capturas/movimientos.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bank account used for the large rent payment (Arriendo, -320.00). Real Ecuadorian bank, consistent with the demo data being plausible for Ecuador."}], "edges": [{"source": "docs_capturas_mov